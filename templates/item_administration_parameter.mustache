{{!
    @template mod_adaptivequiz/item_administration_parameter

    Renders a single item administration parameter.

    Context variables required for this template:
    * name
    * value
    * error - flags if the parameter has invalid value

    Example context (json):
    {
        "name": "startinglevel",
        "value": 2,
        "error": true
    }
}}
<tr class="border-0">
    <td class="border-0 pl-2 text-right font-weight-bold">{{name}}:</td>
    <td class="border-0 pl-3">{{value}}</td>
    <td class="border-0 pl-5">
        <span class="badge {{^error}}bg-success{{/error}}{{#error}}bg-danger{{/error}} text-white">
            {{^error}}{{#str}} ok {{/str}}{{/error}}{{#error}}{{error}}{{/error}}
        </span>
    </td>
</tr>
