{{!
    @template mod_adaptivequiz/item_administration_params

    Renders item administration parameters.

    Context variables required for this template:
    * id - current course module ID
    * hasqbanks - whther there are any question banks linked
    * noqbanksnotification - a wrapper for the core template to display a notification about no question banks linked
    * noparamsnotification - same purpose as for 'noqbanksnotification'
    * invalidparamsnotification - same purose as for 'noqbanksnotification'
    * paramset - whether the parameters are set for this activity instance
    * itemadministrationparams - the set of parameters to render, see mod_adaptivequiz/item_administration_parameter

    Example context (json):
    {
        "id": 1,
        "hasqbanks": false,
        "noqbanksnotification": {
            "message": "No question banks"
        },
        "noparamsnotification": {
            "message": "No parameters set"
        },
        "paramset": false,
        "itemadministrationparams": []
    }
}}
{{< mod_adaptivequiz/item_bank_settings_block}}
    {{$title}}{{#str}} itembankitemadmparams, adaptivequiz {{/str}}{{/title}}
    {{$body}}
        {{^hasqbanks}}
            {{#noqbanksnotification}}
                {{> core/notification_info}}
            {{/noqbanksnotification}}
        {{/hasqbanks}}
        {{#hasqbanks}}
            {{#noparamsnotification}}
                {{> core/notification_warning}}
            {{/noparamsnotification}}
            {{#invalidparamsnotification}}
                {{> core/notification_error}}
            {{/invalidparamsnotification}}
            {{#paramset}}
                <table class="mb-4">
                    <tbody class="border-0">
                        {{#itemadministrationparams}}
                            {{> mod_adaptivequiz/item_administration_parameter}}
                        {{/itemadministrationparams}}
                    </tbody>
                </table>
            {{/paramset}}
        {{/hasqbanks}}
    {{/body}}
    {{$footer}}
        {{#hasqbanks}}
            <button
                    class="btn btn-secondary"
                    data-action="show-edit-params-dialog"
                    data-id="{{id}}"
            >
                {{#str}} itembankitemadmparamsedit, adaptivequiz {{/str}}
            </button>
        {{/hasqbanks}}
    {{/footer}}
    {{$js}}
        require(['mod_adaptivequiz/item_administration_params'], function(ItemBank) {
            ItemBank.init();
        });
    {{/js}}
{{/mod_adaptivequiz/item_bank_settings_block}}
