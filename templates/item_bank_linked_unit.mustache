{{!
    @template mod_adaptivequiz/item_bank_linked_unit

    Renders a linked item bank unit (question bank or question category).

    Context variables required for this template:
    * name
    * url
    * label - optional label to display after the name
    * actions - see the included core template

    Example context (json):
    {
        "name": "Question category",
        "url": "/category",
        "label": "Question bank 1",
        "actons": []
    }
}}
<div class="pb-2">
    <a href="{{{url}}}">{{{name}}}</a>
    {{#label}}
        <span class="badge bg-primary ml-1">{{label}}</span>
    {{/label}}
    {{#actions}}
        {{> core/action_menu_link }}
    {{/actions}}
</div>
