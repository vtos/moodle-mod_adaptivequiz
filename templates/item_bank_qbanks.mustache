{{!
    @template mod_adaptivequiz/item_bank_qbanks

    Renders question banks linked to the item bank.

    Context variables required for this template:
    * hasthiscourseqbanks - whether there are linked question banks in the current course
    * thiscourseqbanks - a list of question banks in the current course, required when 'hasthiscourseqbanks' is true
    * hasothercoursesqbanks - whether there are linked question banks in other courses
    * othercoursesqbanks - a list of question banks in other courses, required when 'hasothercoursesqbanks' is true
    * hasanyqbanks - whether there are any question banks linked, either in this or other courses

    Example context (json):
    {
        "hasthiscourseqbanks": true,
        "thiscourseqbanks": [
            {
                "name": "Question Bank 1",
                "label": "Label",
                "url": "/bank",
                "actions": []
            }
        ],
        "hasothercoursesqbanks": false,
        "hasanyqbanks": true
    }
}}
{{< mod_adaptivequiz/item_bank_settings_block}}
    {{$title}}{{#str}} itembankassignedqbanks, adaptivequiz {{/str}}{{/title}}
    {{$body}}
        {{#hasthiscourseqbanks}}
            {{< mod_adaptivequiz/item_bank_linked_units }}
                {{$unitsid}}qbanksthis{{/unitsid}}
                {{$unitstitle}}
                    {{#str}} itembankthiscourseqbanks, adaptivequiz {{/str}}
                {{/unitstitle}}
                {{$units}}
                    {{#thiscourseqbanks}}
                        {{> mod_adaptivequiz/item_bank_linked_unit }}
                    {{/thiscourseqbanks}}
                {{/units}}
            {{/ mod_adaptivequiz/item_bank_linked_units }}
        {{/hasthiscourseqbanks}}
        {{#hasothercoursesqbanks}}
            {{< mod_adaptivequiz/item_bank_linked_units }}
                {{$unitsid}}qbanksother{{/unitsid}}
                {{$unitstitle}}
                    {{#str}} itembankothercoursesqbanks, adaptivequiz {{/str}}
                {{/unitstitle}}
                {{$units}}
                    {{#othercoursesqbanks}}
                        {{> mod_adaptivequiz/item_bank_linked_unit }}
                    {{/othercoursesqbanks}}
                {{/units}}
            {{/ mod_adaptivequiz/item_bank_linked_units }}
        {{/hasothercoursesqbanks}}
        {{^hasanyqbanks}}
            <p>{{#str}} noquestionbanks, adaptivequiz {{/str}}</p>
        {{/hasanyqbanks}}
    {{/body}}
    {{$footer}}
        <button
                class="btn btn-secondary"
                data-action="show-question-banks-dialog"
                data-id="{{id}}"
                data-course-id="{{courseid}}"
        >
            {{#str}} itembankassignqbank, adaptivequiz {{/str}}
        </button>
    {{/footer}}
    {{$js}}
        require(['mod_adaptivequiz/item_bank'], function(ItemBank) {
            ItemBank.init();
        });
    {{/js}}
{{/mod_adaptivequiz/item_bank_settings_block}}
