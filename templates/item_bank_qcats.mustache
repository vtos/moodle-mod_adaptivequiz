{{!
    @template mod_adaptivequiz/item_bank_qcats

    Renders question categories linked to the item bank.

    Context variables required for this template:
    * hasthiscourseqcats - whether there are linked question categories in the current course
    * thiscourseqcats - a list of question categories in the current course, required when 'hasthiscourseqcats' is true
    * hasothercoursesqcats - whether there are linked question categories in other courses
    * othercoursesqcats - a list of question categories in other courses, required when 'hasothercoursesqcats' is true
    * hasanyqcats - whether there are any question categories linked, either in this or other courses

    Example context (json):
    {
        "hasthiscourseqcats": true,
        "thiscourseqcats": [
            {
                "name": "Category 1",
                "label": "Label",
                "url": "/category",
                "actions": []
            }
        ],
        "hasothercoursesqcats": false,
        "hasanyqcats": true
    }
}}
{{< mod_adaptivequiz/item_bank_settings_block}}
    {{$title}}{{#str}} itembankassignedqcats, adaptivequiz {{/str}}{{/title}}
    {{$body}}
        {{#hasthiscourseqcats}}
            {{< mod_adaptivequiz/item_bank_linked_units }}
                {{$unitstitle}}
                    {{#str}} itembankthiscourseqcats, adaptivequiz {{/str}}
                {{/unitstitle}}
                {{$units}}
                    {{#thiscourseqcats}}
                        {{> mod_adaptivequiz/item_bank_linked_unit }}
                    {{/thiscourseqcats}}
                {{/units}}
            {{/ mod_adaptivequiz/item_bank_linked_units }}
        {{/hasthiscourseqcats}}
        {{#hasothercoursesqcats}}
            {{< mod_adaptivequiz/item_bank_linked_units }}
                {{$unitstitle}}
                    {{#str}} itembankothercoursesqcats, adaptivequiz {{/str}}
                {{/unitstitle}}
                {{$units}}
                    {{#othercoursesqcats}}
                        {{> mod_adaptivequiz/item_bank_linked_unit }}
                    {{/othercoursesqcats}}
                {{/units}}
            {{/ mod_adaptivequiz/item_bank_linked_units }}
        {{/hasothercoursesqcats}}
        {{^hasanyqcats}}
            <p>{{#str}} itembanknoqcats, adaptivequiz {{/str}}</p>
        {{/hasanyqcats}}
    {{/body}}
{{/mod_adaptivequiz/item_bank_settings_block}}
